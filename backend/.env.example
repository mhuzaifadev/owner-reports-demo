# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty to run with template drafts only.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=20

RATE_LIMIT_PER_HOUR=10
